# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
FORGEONE_DB_PASSWORD=change-me-letters-and-digits-only
DATABASE_URL=postgresql://forgeone:change-me-letters-and-digits-only@localhost:5433/forgeone
# optional: RunPod serverless models (see models.example.yaml)
# RUNPOD_API_KEY=rpa_...
# optional
# FORGEONE_MODEL=claude-haiku-5-5        # planner and builder; any name from `forgeone models list`
# FORGEONE_JUDGE_MODEL=                   # verify, edge test, approve
# FORGEONE_AGENT_MODEL=                   # the agent's own model in goal tasks
# FORGEONE_STRONG_MODEL=                  # tasks of difficulty 4-5
# FORGEONE_RUNS_DIR=runs
# FORGEONE_CONTROL_ROOM_URL=https://cashgrab.online   # links in agent repos' BUILD.md
